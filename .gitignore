# === Whitelist .gitignore ===
# デフォルトですべてを無視し、明示的に許可したものだけを管理する

# すべて無視
*

# === ルート設定ファイル ===
!.gitignore
!.gitattributes
!README.md
!ARCHITECTURE.md
!AGENTS.md
!pyproject.toml
!uv.lock

# === ソースコード ===
!pdfops/
!pdfops/**
!scrape/
!scrape/**
!scripts/
!scripts/**
!tests/
!tests/**

# === キャッシュ・ビルド成果物は再除外 ===
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.venv/

# === データ: メタデータのみ ===
# ディレクトリ構造を許可
!data/
!data/magazines/
!data/magazines/**/

# 許可するメタデータファイル
!data/magazines/**/manifest.normalized.json
!data/magazines/**/manifest.raw.json
!data/magazines/issues.expected.json
!data/magazines/issues.raw.json
!data/magazines/batch_summary.json
!data/magazines/verify_report.json
!data/magazines/fact_check_report.json
!data/magazines/auth_diagnostics.json
!data/stock_codes_*.json
